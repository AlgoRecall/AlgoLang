{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AlgoLang",
  "scopeName": "source.algolang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#functionDeclarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#functionCalls" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.algolang",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.algolang",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.algolang",
              "match": "\\\\[nrt\"\\\\]"
            },
            {
              "name": "invalid.illegal.escape.algolang",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "functionDeclarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.algolang" },
            "2": { "name": "entity.name.function.algolang" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.algolang",
          "match": "\\b(if|else|while|for|break|continue|return)\\b"
        },
        {
          "name": "keyword.operator.word.algolang",
          "match": "\\b(and|or|not|in)\\b"
        },
        {
          "name": "support.function.builtin.algolang",
          "match": "\\b(print|len|range)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.algolang",
          "match": "\\b(int|float|bool|string|null|map|set|stack|queue|deque|minheap|maxheap)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.algolang",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.algolang",
          "match": "\\bnull\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.algolang",
          "match": "(?<![A-Za-z0-9_])\\d+\\.\\d+(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.numeric.integer.algolang",
          "match": "(?<![A-Za-z0-9_])\\d+(?![A-Za-z0-9_])"
        }
      ]
    },
    "functionCalls": {
      "patterns": [
        {
          "name": "entity.name.function.call.algolang",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        },
        {
          "name": "variable.other.property.algolang",
          "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.algolang",
          "match": "==|!=|<=|>=|->|[+\\-*/%=<>]"
        }
      ]
    }
  }
}

