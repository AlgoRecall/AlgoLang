{
  "name": "algolang",
  "displayName": "AlgoLang",
  "description": "Syntax highlighting and execution commands for the AlgoLang algorithm-learning language.",
  "version": "0.1.0",
  "publisher": "algolang",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "algorithms",
    "data structures",
    "leetcode",
    "education"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:algolang",
    "onCommand:algolang.run",
    "onCommand:algolang.check",
    "onCommand:algolang.ast",
    "onCommand:algolang.dryrun"
  ],
  "contributes": {
    "languages": [
      {
        "id": "algolang",
        "aliases": [
          "AlgoLang",
          "algo"
        ],
        "extensions": [
          ".algo"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "algolang",
        "scopeName": "source.algolang",
        "path": "./syntaxes/algolang.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "algolang",
        "path": "./snippets/algolang.json"
      }
    ],
    "commands": [
      {
        "command": "algolang.run",
        "title": "AlgoLang: Run File",
        "category": "AlgoLang",
        "icon": "$(play)"
      },
      {
        "command": "algolang.check",
        "title": "AlgoLang: Check File",
        "category": "AlgoLang",
        "icon": "$(check)"
      },
      {
        "command": "algolang.ast",
        "title": "AlgoLang: Show AST",
        "category": "AlgoLang",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "algolang.dryrun",
        "title": "AlgoLang: Dry Run File",
        "category": "AlgoLang",
        "icon": "$(debug-alt)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "algolang.run",
          "when": "resourceLangId == algolang",
          "group": "navigation@1"
        },
        {
          "command": "algolang.dryrun",
          "when": "resourceLangId == algolang",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "algolang.run",
          "when": "resourceLangId == algolang",
          "group": "1_run@1"
        },
        {
          "command": "algolang.check",
          "when": "resourceLangId == algolang",
          "group": "1_run@2"
        },
        {
          "command": "algolang.dryrun",
          "when": "resourceLangId == algolang",
          "group": "1_run@3"
        }
      ],
      "commandPalette": [
        {
          "command": "algolang.run",
          "when": "resourceLangId == algolang"
        },
        {
          "command": "algolang.check",
          "when": "resourceLangId == algolang"
        },
        {
          "command": "algolang.ast",
          "when": "resourceLangId == algolang"
        },
        {
          "command": "algolang.dryrun",
          "when": "resourceLangId == algolang"
        }
      ]
    },
    "configuration": {
      "title": "AlgoLang",
      "properties": {
        "algolang.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Python executable used to launch AlgoLang. On Windows this may be 'python'."
        },
        "algolang.runtimeDirectory": {
          "type": "string",
          "default": "",
          "description": "Directory containing the algolang Python package. Empty uses the current workspace folder."
        },
        "algolang.clearOutputBeforeRun": {
          "type": "boolean",
          "default": true,
          "description": "Clear the AlgoLang output channel before each command."
        },
        "algolang.revealOutput": {
          "type": "string",
          "enum": [
            "always",
            "onError",
            "never"
          ],
          "default": "always",
          "description": "When to reveal the AlgoLang output channel."
        }
      }
    }
  },
  "scripts": {
    "check": "node --check extension.js"
  }
}
