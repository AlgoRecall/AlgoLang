{
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:value}: ${3:int}) -> ${4:int} {",
      "    ${5:return value}",
      "}"
    ],
    "description": "Typed AlgoLang function"
  },
  "If": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "    ${2}",
      "}"
    ],
    "description": "If block"
  },
  "While": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "    ${2}",
      "}"
    ],
    "description": "While loop"
  },
  "For value": {
    "prefix": "for",
    "body": [
      "for ${1:value} in ${2:values} {",
      "    ${3}",
      "}"
    ],
    "description": "For-each loop"
  },
  "For index and value": {
    "prefix": "fori",
    "body": [
      "for ${1:index}, ${2:value} in ${3:values} {",
      "    ${4}",
      "}"
    ],
    "description": "Indexed for-each loop"
  }
}

